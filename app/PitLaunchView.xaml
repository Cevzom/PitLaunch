<UserControl x:Class="PitLaunch.PitLaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="True"
             Background="#0E100F"
             FontFamily="pack://application:,,,/PitLaunch;component/assets/fonts/#Cabin"
             TextOptions.TextFormattingMode="Ideal"
             RenderOptions.BitmapScalingMode="HighQuality"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        <!-- Cabin for UI text, Space Grotesk for display type: the two faces the reference
             interface uses. Static instances are embedded under assets/fonts (OFL). -->
        <FontFamily x:Key="BodyFont">pack://application:,,,/PitLaunch;component/assets/fonts/#Cabin</FontFamily>
        <FontFamily x:Key="DisplayFont">pack://application:,,,/PitLaunch;component/assets/fonts/#Space Grotesk</FontFamily>

        <!-- Neutrals are cool-grey rather than green-tinted so the cyan brand sits naturally.
             The rail is the LIGHTER surface and the canvas the darker one, matching the
             reference's tonal order; the palette itself is unchanged. -->
        <SolidColorBrush x:Key="WindowBrush" Color="#0D0F11" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#16191D" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#111417" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#181C20" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2024" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#24292E" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#282D33" />
        <SolidColorBrush x:Key="BorderBrush" Color="#333942" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#282D33" />
        <SolidColorBrush x:Key="TextBrush" Color="#EFF2F5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A3AAB3" />
        <SolidColorBrush x:Key="FaintBrush" Color="#717983" />
        <SolidColorBrush x:Key="AccentBrush" Color="#20B8F0" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#0E3348" />
        <SolidColorBrush x:Key="AccentInkBrush" Color="#04202C" />
        <!-- Violet, so category badges stay legible beside a cyan accent instead of competing with it. -->
        <SolidColorBrush x:Key="InfoBrush" Color="#A98BFF" />
        <SolidColorBrush x:Key="InfoSoftBrush" Color="#2A2450" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E7B86C" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#392D1B" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF8E86" />
        <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3B211F" />

        <QuarticEase x:Key="EaseOut" EasingMode="EaseOut" />
        <QuinticEase x:Key="EaseOutStrong" EasingMode="EaseOut" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <!-- Ideal, not Display: Display quantises stems and advance widths to whole pixels,
                 which only looks right for fonts hinted for it (Segoe UI). Cabin and Space
                 Grotesk are not, so Display made them read as chunky and unevenly spaced. -->
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="38" />
            <Setter Property="LineHeight" Value="46" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="Hover" CornerRadius="5" Background="#10EFF2F5" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Filter pill: standalone rounded tab, no shared track. The template paints nothing on
             hover so the accent fill behind an active pill is never covered up. -->
        <Style x:Key="FilterPill" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="17,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
            <Setter Property="BorderBrush" Value="#68403C" />
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- Rail destination: a 38 px full-bleed row, no card and no rounded pill. Active state is
             carried by the label colour plus the accent bar on the rail's content edge, so hover
             stays a faint wash that cannot be mistaken for selection. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.76" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#16FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dashed "add something" tile, matching the empty-slot pattern people expect. -->
        <Style x:Key="BrowseTileButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Fill" CornerRadius="7" Background="{TemplateBinding Background}" />
                            <Rectangle x:Name="Dashes" RadiusX="7" RadiusY="7" Fill="Transparent"
                                       Stroke="{StaticResource BorderBrush}" StrokeThickness="1"
                                       StrokeDashArray="4 3" SnapsToDevicePixels="True" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet "an update is waiting" affordance for the bottom of the sidebar. -->
        <Style x:Key="UpdateBannerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
            <Setter Property="BorderBrush" Value="#453A78" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#322A5C" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,7" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" CornerRadius="4" Background="Transparent" Padding="10,7" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Picker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="{StaticResource BorderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0,0,0" HorizontalAlignment="Left" Fill="{StaticResource MutedBrush}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentInkBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextBrush}" /><Setter TargetName="Track" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedChoice" TargetType="RadioButton">
            <Setter Property="Height" Value="54" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupMonitorChoice" TargetType="ToggleButton">
            <Setter Property="Width" Value="242" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="SelectionRail" Width="3" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="-7,6,0,6" Opacity="0" />
                                <ContentPresenter Margin="5,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SelectionRail" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource FaintBrush}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome" Margin="2,1" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource MutedBrush}" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unframed: the reference's list pages carry no card around a group of rows, so the
             section label and the row rhythm do the grouping instead of a border. -->
        <Style x:Key="SectionPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Height" Value="94" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootShell" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource WindowBrush}">
            <Grid x:Name="TitleDragZone" Background="Transparent" MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="TitleRailColumn" Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- Identity now lives at the top of the rail, so this strip only continues the rail surface upward. -->
                <Border x:Name="TitleRailFill" Background="{StaticResource SidebarBrush}" />
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1,0,0,1" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="Close to tray" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="SidebarHost" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,1,0" />
            <!-- No horizontal inset: rail rows are full-bleed so hover and the active bar can
                 reach the rail's edges. The identity block and footer carry their own padding. -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <!-- Identity heads the rail: centred mark with deliberate space either side of it. -->
                    <StackPanel x:Name="RailIdentity" HorizontalAlignment="Center" Margin="0,26,0,38">
                        <Image Source="/PitLaunch;component/assets/pitlaunch-mark.png" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="PitLaunch" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#17547A" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="7,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BETA" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <!-- Height is rows x 38; the bar's resting offset per row is row*38 + 9. -->
                    <Grid x:Name="NavigationHost" Height="76" ClipToBounds="False">
                        <StackPanel>
                            <Button x:Name="SetupsNav" Style="{StaticResource NavButton}" Click="Back_Click" AutomationProperties.Name="Setups">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="17" Width="26" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Setups" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click" AutomationProperties.Name="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="17" Width="26" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Settings" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Sits hard against the rail's content edge, over the 1 px divider. -->
                        <Border x:Name="NavActivePill" Width="3" Height="20" Background="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,0,0" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="12,0,12,14">
                    <Button x:Name="UpdateBanner" Style="{StaticResource UpdateBannerButton}" Visibility="Collapsed" Opacity="0"
                            Click="UpdateBanner_Click" AutomationProperties.Name="Update available"
                            ToolTip="A new version is ready. Click to review and install it.">
                        <Button.RenderTransform><TranslateTransform x:Name="UpdateBannerSlide" Y="6" /></Button.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse x:Name="UpdateBannerHalo" Width="18" Height="18" Fill="{StaticResource InfoBrush}" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="UpdateBannerPulse" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Update available" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="UpdateBannerVersion" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!-- "Restore displays" used to sit here; it is already in Settings > Safety and
                         on a global hotkey, and the reference rail ends in a single quiet chip. -->
                    <Border x:Name="CurrentStrip" CornerRadius="15" Height="30" Background="#14FFFFFF" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Padding="11,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="CurrentName" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CurrentSummary" Foreground="{StaticResource FaintBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="PageStage" Grid.Row="1" Grid.Column="1" Background="{StaticResource CanvasBrush}" ClipToBounds="True">
            <Grid x:Name="HomePage" Margin="44,30,44,14" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="StartupEyebrow" Text="PITLAUNCH IS READY" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AccentBrush}" Margin="1,0,0,7" Visibility="Collapsed" />
                        <TextBlock x:Name="HomeTitle" Style="{StaticResource PageTitle}"><Run x:Name="HomeTitleLead" Text="PitLaunch " /><Run x:Name="HomeTitleAccent" Text="Setups" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                        <TextBlock x:Name="HomeSubtitle" Text="Switch the whole PC between your desk and rig in one move." Style="{StaticResource CaptionText}" Margin="1,5,0,0" />
                    </StackPanel>
                    <Button x:Name="CaptureButton" Style="{StaticResource PrimaryButton}" Click="Capture_Click" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Create setup">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AccentInkBrush}" />
                            <TextBlock Text="Create setup" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel x:Name="StatsSection" Grid.Row="1" Margin="0,26,0,0">
                <TextBlock Text="At a glance" Style="{StaticResource SectionTitle}" Margin="0,0,0,11" />
                <Grid x:Name="StatsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StatTile}">
                        <Grid>
                            <ui:SymbolIcon Symbol="AppsList24" FontSize="62" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-11,-13" />
                            <StackPanel>
                                <TextBlock x:Name="SetupStatValue" Text="0" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="SAVED SETUPS" Style="{StaticResource EyebrowText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource BorderSoftBrush}" VerticalAlignment="Bottom">
                                <Border x:Name="SetupStatBar" Background="{StaticResource AccentBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatTile}">
                        <Grid>
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="62" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-11,-13" />
                            <StackPanel>
                                <TextBlock x:Name="DisplayStatValue" Text="0" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="ACTIVE DISPLAYS" Style="{StaticResource EyebrowText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource BorderSoftBrush}" VerticalAlignment="Bottom">
                                <Border x:Name="DisplayStatBar" Background="{StaticResource InfoBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource StatTile}">
                        <Grid>
                            <ui:SymbolIcon Symbol="PlayCircle24" FontSize="62" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-11,-13" />
                            <StackPanel>
                                <TextBlock x:Name="AutomationStatValue" Text="0" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="AUTOMATED" Style="{StaticResource EyebrowText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource BorderSoftBrush}" VerticalAlignment="Bottom">
                                <Border x:Name="AutomationStatBar" Background="{StaticResource WarningBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,24,0,12">
                    <TextBlock x:Name="SavedSetupsTitle" Text="Saved setups" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ProfileCount" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                </Grid>

                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="ProfileScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                        <Grid>
                            <StackPanel x:Name="ProfileWrap" />
                            <UniformGrid x:Name="StartupProfileWrap" Columns="2" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                        </Grid>
                    </ScrollViewer>
                    <Border x:Name="EmptyState" Visibility="Collapsed" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}" Padding="36">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,18">
                                <ui:SymbolIcon Symbol="Desktop24" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyStateTitle" Text="Create your first setup" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateCopy" Text="Start with Desk. When the rig is connected, create a second Sim racing setup." Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,20" />
                            <Button x:Name="EmptyStateCaptureButton" Style="{StaticResource PrimaryButton}" Content="Create setup" Click="Capture_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="ProfilePage" Visibility="Collapsed" Margin="44,28,44,14" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions><RowDefinition Height="96" /><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Button Style="{StaticResource QuietButton}" Click="Back_Click" Height="26" Padding="0" Margin="0,0,8,0" AutomationProperties.Name="Back to setups">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Setups" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProfileTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="ProfileCurrentBadge" Margin="10,6,0,0" Padding="8,3" CornerRadius="5" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Active" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ProfileMeta" Style="{StaticResource CaptionText}" Margin="1,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RenameButton" Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Rename setup" Click="Rename_Click" Margin="0,0,4,0" />
                        <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete setup" Click="Delete_Click" Margin="0,0,8,0" />
                        <Button x:Name="ProfileSwitchButton" Style="{StaticResource PrimaryButton}" Content="Switch to setup" Click="ProfileSwitch_Click" />
                    </StackPanel>
                </Grid>

                <!-- Separate pills on the page surface, not segments inside a shared track. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid Margin="0,0,8,0">
                        <Border CornerRadius="15" Background="#14FFFFFF" />
                        <Border x:Name="SnapshotIndicator" CornerRadius="15" Background="{StaticResource AccentBrush}" />
                        <Button x:Name="SnapshotTab" Style="{StaticResource FilterPill}" Content="Hardware" Click="SnapshotTab_Click" Foreground="{StaticResource AccentInkBrush}" />
                    </Grid>
                    <Grid>
                        <Border CornerRadius="15" Background="#14FFFFFF" />
                        <Border x:Name="AutomationIndicator" CornerRadius="15" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <Button x:Name="AutomationTab" Style="{StaticResource FilterPill}" Content="Automation" Click="AutomationTab_Click" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,18,0,0" ClipToBounds="True">
                    <ScrollViewer x:Name="SnapshotPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,0">
                        <StackPanel>
                            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Setup identity" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Tell PitLaunch whether this is a desk or sim-racing setup." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Save identity" Click="SaveSetupIdentity_Click" VerticalAlignment="Top" />
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Setup type" Style="{StaticResource CaptionText}" />
                                            <ComboBox x:Name="SetupKindPicker" Style="{StaticResource Picker}" Margin="0,5,0,0" SelectionChanged="SetupKindPicker_SelectionChanged" AutomationProperties.Name="Setup type" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Rig display variant" Style="{StaticResource CaptionText}" />
                                            <ComboBox x:Name="RigDisplayPicker" Style="{StaticResource Picker}" Margin="0,5,0,0" AutomationProperties.Name="Rig display variant" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,11">
                                        <StackPanel>
                                            <TextBlock Text="Display layout" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Captured arrangement, resolution, and primary display." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="DisplayCount" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    </Grid>
                                    <Viewbox Stretch="Uniform" Height="132" HorizontalAlignment="Stretch"><Canvas x:Name="MonitorCanvas" Width="680" Height="168" /></Viewbox>
                                    <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,9,0,0">
                                        <StackPanel x:Name="MonitorListPanel" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.28*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SectionPanel}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15">
                                            <StackPanel>
                                                <TextBlock Text="Sound" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Devices used when this setup becomes active." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource InfoSoftBrush}" CornerRadius="5" Padding="7,3">
                                                <TextBlock Text="Editable" Foreground="{StaticResource InfoBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Playback" Style="{StaticResource CaptionText}" />
                                        <ComboBox x:Name="PlaybackPicker" Style="{StaticResource Picker}" Margin="0,5,0,11" AutomationProperties.Name="Playback device" />
                                        <TextBlock Text="Communications" Style="{StaticResource CaptionText}" />
                                        <ComboBox x:Name="CommunicationsPicker" Style="{StaticResource Picker}" Margin="0,5,0,11" AutomationProperties.Name="Communications device" />
                                        <TextBlock Text="Microphone" Style="{StaticResource CaptionText}" />
                                        <ComboBox x:Name="MicrophonePicker" Style="{StaticResource Picker}" Margin="0,5,0,15" AutomationProperties.Name="Microphone device" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Save sound devices" Click="SaveAudio_Click" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SectionPanel}">
                                    <StackPanel>
                                        <TextBlock Text="Captured state" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Window placement and snapshot age." Style="{StaticResource CaptionText}" Margin="0,4,0,18" />
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="WINDOWS" Style="{StaticResource EyebrowText}" />
                                                <TextBlock x:Name="WindowCountValue" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="CAPTURED" Style="{StaticResource EyebrowText}" />
                                        <TextBlock x:Name="CapturedValue" FontSize="13" Margin="0,5,0,20" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Recapture setup" Click="Recapture_Click" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AutomationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,0">
                        <StackPanel>
                            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Global hotkey" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Click the field, then press the shortcut." Style="{StaticResource CaptionText}" Margin="0,4,20,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBox x:Name="HotkeyInput" Grid.Column="1" Style="{StaticResource TextInput}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" AutomationProperties.Name="Global hotkey" ToolTip="Click here, then press the key combination. Backspace clears it." PreviewKeyDown="HotkeyInput_PreviewKeyDown" PreviewKeyUp="HotkeyInput_PreviewKeyUp" LostKeyboardFocus="HotkeyInput_LostFocus" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,11">
                                <StackPanel>
                                    <TextBlock Text="Applications" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Start or close apps with this setup." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="AddApplication_Click" AutomationProperties.Name="Add application">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" /><TextBlock Text="Add application" /></StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="AppsPanel" Margin="0,0,0,24" />

                            <Grid Margin="0,0,0,11">
                                <StackPanel>
                                    <TextBlock Text="Game detection" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Activate this setup when a saved process starts." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Click="AddGameProcess_Click" Margin="0,0,8,0" AutomationProperties.Name="Add running app"
                                            ToolTip="Type a process name, or pick from the apps running right now.">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" /><TextBlock Text="Manually" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Click="AddGame_Click" AutomationProperties.Name="Add a game"
                                            ToolTip="Pick from the games installed on this PC.">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" /><TextBlock Text="Add game" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="GamesPanel" Margin="0,0,0,22" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Save automation" HorizontalAlignment="Right" Click="SaveAutomation_Click" Margin="0,0,0,8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="44,30,44,14" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}"><Run Text="PitLaunch " /><Run Text="Settings" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                        <TextBlock Text="Startup, automatic switching, and support tools." Style="{StaticResource CaptionText}" Margin="1,5,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Right padding clears the overlay scrollbar; at 7 the row controls were clipped. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,28,20,0">
                    <!-- Full-width rows, not a 780 px reading column: the reference's list pages run
                         the row and its control out to the content edges. -->
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Startup" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,26">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <StackPanel><TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Keep PitLaunch ready after you sign in." Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel>
                                        <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Start PitLaunch with Windows" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <StackPanel><TextBlock Text="Show setup chooser after sign-in" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Ask whether to use the desk or sim setup when Windows starts." Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel>
                                        <CheckBox x:Name="ChooserToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Show the setup chooser after sign-in" />
                                    </Grid>
                                </Border>
                                <Border Padding="0,17">
                                    <Grid>
                                        <StackPanel Margin="0,0,190,0">
                                            <TextBlock Text="Reliable startup" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Optional delayed fallback if Windows skips normal startup." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ReliableStartupStatus" Text="Checking Windows Task Scheduler..." Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="ReliableStartupButton" Style="{StaticResource SecondaryButton}" Click="ReliableStartup_Click" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Uses administrator approval once to install a least-privilege startup fallback" AutomationProperties.Name="Configure reliable startup">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ShieldTask24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,7,0" />
                                                <TextBlock x:Name="ReliableStartupActionText" Text="Install" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Safety" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,26">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <StackPanel Margin="0,0,80,0"><TextBlock Text="Confirm before switching" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Beta safety check before displays or sound devices change." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                                        <CheckBox x:Name="ConfirmSwitchToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Ask before switching setups" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <StackPanel Margin="0,0,170,0"><TextBlock Text="Restore every display" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Enable all monitors Windows currently detects without changing saved setups." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Restore displays" Click="RestoreDisplays_Click" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Restore all displays" />
                                    </Grid>
                                </Border>
                                <Border Padding="0,17">
                                    <Grid>
                                        <StackPanel Margin="0,0,190,0"><TextBlock Text="Emergency keyboard shortcut" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Works while PitLaunch is running, even when its window is hidden." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource ChromeBrush}" Padding="10,7">
                                            <TextBlock Text="Ctrl + Alt + Shift + F12" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Automatic switching" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,26">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <StackPanel><TextBlock Text="Detect racing games" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Switch when a process saved in a setup starts or exits." Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel>
                                        <CheckBox x:Name="DetectionToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Detect saved game processes" />
                                    </Grid>
                                </Border>
                                <Border Padding="0,14">
                                    <Grid>
                                        <StackPanel><TextBlock Text="Detection interval" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Seconds between process checks." Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource ChromeBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE738;" ToolTip="Decrease interval" Click="PollDown_Click" Width="36" Height="36" />
                                                <TextBlock x:Name="PollValue" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Increase interval" Click="PollUp_Click" Width="36" Height="36" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionPanel}" Padding="0,2" Margin="0,0,0,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock x:Name="UpdateVersionText" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="Check for updates" Click="CheckUpdate_Click" Margin="0,0,8,0" />
                                        <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" Content="Install and restart" Click="InstallUpdate_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,14,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"
                                             Background="{StaticResource ChromeBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Data and diagnostics" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionPanel}" Padding="0,2" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="PitLaunch Beta 0.9.1" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Open saved profiles or the activity log when troubleshooting." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Data folder" Click="OpenData_Click" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Activity log" Click="OpenLog_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Primary action is pinned below the list rather than floating top-right,
                     so the commit control sits where the reading order ends. -->
                <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="42" HorizontalAlignment="Stretch"
                        Margin="0,16,20,0" Click="SaveSettings_Click" AutomationProperties.Name="Save settings">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AccentInkBrush}" />
                        <TextBlock Text="Save settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="BusyLayer" Visibility="Collapsed" Opacity="0" Background="#D90D0F11">
                <Border Width="360" Padding="28,26" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="38" Height="38" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,17">
                            <Grid.RenderTransform><RotateTransform x:Name="BusySpinnerRotation" /></Grid.RenderTransform>
                            <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="3" />
                            <Path Data="M 19,2 A 17,17 0 0 1 36,19" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock x:Name="BusyMessage" Text="Switching setup" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Displays may blink while Windows reconnects them." Style="{StaticResource CaptionText}" Margin="0,7,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Persistent status strip: version on the left, help on the right, present on every page. -->
        <Grid Grid.Row="2" Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <Grid Margin="44,0,44,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="PitLaunch" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusBarVersion" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Guide and updates on" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                    <Button x:Name="StatusBarRepoLink" Style="{StaticResource QuietButton}" Height="22" Padding="5,0" Margin="1,0,-5,0"
                            Foreground="{StaticResource AccentBrush}" Click="StatusBarRepoLink_Click"
                            AutomationProperties.Name="Open the PitLaunch repository"
                            ToolTip="Open the PitLaunch page in your browser">
                        <TextBlock Text="GitHub" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="ToastPanel" Grid.Row="1" Grid.Column="1" Width="390" MinHeight="78" Padding="16,14" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Visibility="Collapsed" Opacity="0">
            <Border.RenderTransform><TranslateTransform Y="18" /></Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="ToastMarker" Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="ToastDetail" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="DialogLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0" Background="#D00D0F11" MouseLeftButtonDown="DialogLayer_MouseLeftButtonDown">
            <Border Width="440" Padding="24" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogBody" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,18" />
                    <TextBlock x:Name="DialogInputLabel" Text="Setup name" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,7" />
                    <TextBox x:Name="DialogInput" Style="{StaticResource TextInput}" MaxLength="60" AutomationProperties.Name="Setup name" KeyDown="DialogInput_KeyDown" />
                    <TextBlock x:Name="DialogInputHint" Text="Examples: Desk, Sim rig, Triple-screen racing." Style="{StaticResource CaptionText}" Margin="2,7,0,0" />
                    <TextBlock x:Name="DialogError" Foreground="{StaticResource ErrorBrush}" FontSize="12" FontWeight="SemiBold" Margin="2,7,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource QuietButton}" Content="Cancel" IsCancel="True" Click="DialogCancel_Click" Margin="0,0,8,0" />
                        <Button x:Name="DialogConfirm" Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="DialogConfirm_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pick a game from the installed library instead of typing a process name. -->
        <Grid x:Name="GamePickerLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0" Background="#D80D0F11" MouseLeftButtonDown="GamePickerLayer_MouseLeftButtonDown">
            <Border Width="470" MaxHeight="560" Padding="0" CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Add a game" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0" />

                    <Grid x:Name="GamePickerScanning" Grid.Row="1" Margin="0,18,0,4" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="17" Height="17" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                                <Grid.RenderTransform><RotateTransform x:Name="GamePickerSpinner" /></Grid.RenderTransform>
                                <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="2" />
                                <Path Data="M 8.5,1 A 7.5,7.5 0 0 1 16,8.5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" />
                            </Grid>
                            <TextBlock Text="Scanning for games..." Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="GamePickerScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,10,10,0" Visibility="Collapsed">
                        <StackPanel x:Name="GamePickerList" Margin="0,0,6,0" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Margin="16,14,16,18">
                        <Button x:Name="GamePickerBrowse" Style="{StaticResource BrowseTileButton}" Click="GamePickerBrowse_Click" AutomationProperties.Name="Choose custom path">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Choose custom path" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE8DA;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Button>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="11,9" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="GamePickerHint" Text="Not seeing your game? Use Choose custom path." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource QuietButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,8,0,0" Click="GamePickerCancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SetupGuideLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0" Background="#D80D0F11" MouseLeftButtonDown="SetupGuideLayer_MouseLeftButtonDown">
            <Border Width="860" MaxHeight="700" Padding="28,26,28,24" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/PitLaunch;component/assets/pitlaunch-mark.png" Width="32" Height="32" Stretch="Uniform" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Create setup" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="SetupGuideStepLabel" Text="STEP 1 OF 2" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Cancel setup" Click="SetupGuideCancel_Click" AutomationProperties.Name="Cancel setup guide" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,24,0,22" ClipToBounds="True">
                        <Grid x:Name="SetupGuideIdentityStep">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <StackPanel>
                                <TextBlock Text="What are you setting up?" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Choose the place you are preparing now." Style="{StaticResource CaptionText}" Margin="0,5,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="SetupDeskChoice" GroupName="SetupGuideType" Style="{StaticResource SegmentedChoice}" Checked="SetupGuideType_Checked" AutomationProperties.Name="Desk setup">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,8,0" />
                                            <TextBlock Text="Desk" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="SetupSimChoice" Grid.Column="2" GroupName="SetupGuideType" Style="{StaticResource SegmentedChoice}" Checked="SetupGuideType_Checked" AutomationProperties.Name="Sim racing setup">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Sport24" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,8,0" />
                                            <TextBlock Text="Sim racing" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Setup name" Style="{StaticResource CaptionText}" />
                                        <TextBox x:Name="SetupGuideName" Style="{StaticResource TextInput}" Margin="0,5,0,0" MaxLength="60" AutomationProperties.Name="New setup name" />
                                    </StackPanel>
                                    <StackPanel x:Name="SetupGuideVariantHost" Grid.Column="2">
                                        <TextBlock Text="Rig display variant" Style="{StaticResource CaptionText}" />
                                        <ComboBox x:Name="SetupGuideVariant" Style="{StaticResource Picker}" Margin="0,5,0,0" AutomationProperties.Name="New setup display variant" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SetupGuideError" Foreground="{StaticResource ErrorBrush}" FontSize="12" FontWeight="SemiBold" Margin="2,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SetupGuidePrepareStep" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock x:Name="SetupGuidePrepareTitle" Text="Choose this setup's hardware" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="PitLaunch found the devices connected to this PC. Choose what belongs to this setup; nothing changes until you create it." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,5,0,15" TextWrapping="Wrap" />

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="246" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Displays" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock x:Name="SetupGuideDeviceCount" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" FontSize="12" />
                                            </Grid>
                                            <WrapPanel x:Name="SetupGuideDisplayList" HorizontalAlignment="Left" />
                                            <Grid Margin="0,4,8,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Main screen" Style="{StaticResource CaptionText}" FontSize="12" />
                                                    <ComboBox x:Name="SetupGuideMainPicker" Style="{StaticResource Picker}" Margin="0,5,0,0" SelectionChanged="SetupGuideMainPicker_SelectionChanged" AutomationProperties.Name="Main display" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Arrangement" Style="{StaticResource CaptionText}" FontSize="12" />
                                                    <ComboBox x:Name="SetupGuideLayoutPicker" Style="{StaticResource Picker}" Margin="0,5,0,0" SelectionChanged="SetupGuideLayoutPicker_SelectionChanged" AutomationProperties.Name="Display arrangement" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="2" Height="198" CornerRadius="7" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock Text="LIVE LAYOUT" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AccentBrush}" />
                                                <ContentControl x:Name="SetupGuidePreviewHost" Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                                <TextBlock x:Name="SetupGuidePreviewSummary" Grid.Row="2" Style="{StaticResource CaptionText}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,15,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Sound output" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Games, music, and calls use this device." Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                                <ComboBox x:Name="SetupGuidePlaybackPicker" Style="{StaticResource Picker}" Margin="0,7,0,0" AutomationProperties.Name="Setup sound output" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Microphone" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Your default input for this setup." Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                                <ComboBox x:Name="SetupGuideMicrophonePicker" Style="{StaticResource Picker}" Margin="0,7,0,0" AutomationProperties.Name="Setup microphone" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="SetupGuideValidationStrip" CornerRadius="6" Background="{StaticResource InfoSoftBrush}" BorderBrush="#453A78" BorderThickness="1" Padding="12,10" Margin="0,15,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{StaticResource InfoBrush}" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SetupGuideValidationText" Grid.Column="1" Text="PitLaunch will validate this plan with Windows before saving or switching." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="SetupGuideHardwareError" Foreground="{StaticResource ErrorBrush}" FontSize="12" FontWeight="SemiBold" Margin="2,9,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Button Style="{StaticResource QuietButton}" Content="Cancel" HorizontalAlignment="Left" Click="SetupGuideCancel_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SetupGuideBackButton" Style="{StaticResource QuietButton}" Content="Back" Click="SetupGuideBack_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                            <Button x:Name="SetupGuideNextButton" Style="{StaticResource PrimaryButton}" Content="Continue" Click="SetupGuideNext_Click" />
                            <Button x:Name="SetupGuideCaptureButton" Style="{StaticResource PrimaryButton}" Content="Create and switch" Click="SetupGuideCapture_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
