<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\pitlaunch-v4.ico</ApplicationIcon>
    <ApplicationManifest>app\app.manifest</ApplicationManifest>
    <AssemblyName>PitLaunch</AssemblyName>
    <RootNamespace>PitLaunch</RootNamespace>
    <Version>0.9.7-beta.1</Version>
    <AssemblyVersion>0.9.7.0</AssemblyVersion>
    <FileVersion>0.9.7.0</FileVersion>
    <InformationalVersion>0.9.7-beta.1</InformationalVersion>
    <Product>PitLaunch Beta</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="app\**\*.cs" />
    <Page Include="app\PitLaunchView.xaml" />
    <Resource Include="assets\pitlaunch-mark.png" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
